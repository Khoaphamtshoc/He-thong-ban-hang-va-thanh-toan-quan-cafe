# Server Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# Database Configuration
# Chuyển sang DB_TYPE=postgres khi chạy với PostgreSQL
DB_TYPE=sqlite
DB_DATABASE=database.sqlite

# PostgreSQL config (khi DB_TYPE=postgres):
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=cafe_pos

# JWT Secrets
JWT_ACCESS_SECRET=super_secret_access_jwt_key_2026_cafe_management
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_2026_cafe_management
JWT_REFRESH_EXPIRES_IN=7d
