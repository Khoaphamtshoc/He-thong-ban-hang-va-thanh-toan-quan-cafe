@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="app-shell">
    <aside class="sidebar">
        <a class="brand" href="/dashboard"><span class="brand-mark">☕</span><span><b>Gỗ</b><small>COFFEE</small></span></a>
        <div class="side-label">TỔNG QUAN</div>
        <nav class="menu">
            <a href="/dashboard" class="@(Active("dashboard") || Active("home") ? "active" : "")"><span>◫</span> Tổng quan</a>
            <a href="/sales" class="@(Active("sales") ? "active" : "")"><span>＋</span> Bán hàng <kbd>F2</kbd></a>
            <a href="/orders" class="@(Active("orders") ? "active" : "")"><span>▤</span> Đơn hàng <i class="nav-dot"></i></a>
        </nav>
        <div class="side-label">QUẢN LÝ</div>
        <nav class="menu">
            <a href="/products" class="@(Active("products") ? "active" : "")"><span>◉</span> Thực đơn</a>
            <a href="/inventory" class="@(Active("inventory") ? "active" : "")"><span>▥</span> Kho nguyên liệu <i class="nav-count">3</i></a>
            <a href="/reports" class="@(Active("reports") ? "active" : "")"><span>⌁</span> Doanh thu</a>
            <a href="/employees" class="@(Active("employees") ? "active" : "")"><span>♙</span> Nhân viên</a>
        </nav>
        <div class="sidebar-bottom"><div class="help-card"><div>✳</div><b>Cần hỗ trợ?</b><p>Liên hệ đội ngũ Gỗ Coffee bất cứ lúc nào.</p><a href="mailto:hello@moc.coffee">Liên hệ hỗ trợ ↗</a></div>
            <div class="profile"><div class="avatar">AD</div><div class="profile-info"><b>Anh Duy</b><small>Quản lý cửa hàng</small></div><button class="icon-button" title="Đăng xuất" @onclick="Logout">↗</button></div>
        </div>
    </aside>
    <main class="main-area">
        <header class="topbar"><div class="breadcrumbs">Cửa hàng <span>/</span> <b>@PageName</b></div><div class="top-actions"><span class="open-status"><i></i> Đang mở cửa</span><span class="top-divider"></span><span class="today">Thứ Tư, 24 Tháng 9, 2026</span><button class="top-icon" aria-label="Thông báo">♧<i></i></button><div class="avatar top-avatar">AD</div></div></header>
        <section class="page-content">@Body</section>
    </main>
</div>
<div id="blazor-error-ui">Có lỗi xảy ra. <a href="." class="reload">Tải lại</a></div>
@code {
    private string Path => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Trim('/').ToLowerInvariant();
    private bool Active(string route) => Path == route || (route == "dashboard" && Path == "");
    private string PageName => Path switch { "" or "dashboard" => "Tổng quan", "sales" => "Bán hàng", "orders" => "Đơn hàng", "products" => "Thực đơn", "inventory" => "Kho nguyên liệu", "reports" => "Doanh thu", "employees" => "Nhân viên", "login" => "Đăng nhập", _ => "Tổng quan" };
    private void Logout() => Navigation.NavigateTo("/login");
}
