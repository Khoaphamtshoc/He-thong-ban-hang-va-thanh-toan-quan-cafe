@page "/products"
@rendermode InteractiveServer
@using System.Globalization
<PageTitle>Thực đơn · mộc. Coffee</PageTitle>
<div class="page-heading"><div><div class="eyebrow">QUẢN LÝ <span class="eyebrow-dot"></span> THỰC ĐƠN</div><h1>Thực đơn của bạn</h1><p>Quản lý các món uống và bánh ngọt tại cửa hàng.</p></div><button class="button button-primary" @onclick="AddProduct">＋ Thêm món mới</button></div>
<div class="menu-stats"><div class="surface mini-stat"><span>Tổng số món</span><b>@_products.Count <small>món</small></b></div><div class="surface mini-stat"><span>Đang kinh doanh</span><b>12 <small>món</small></b></div><div class="surface mini-stat"><span>Hết hàng</span><b class="low-stock-stat">2 <small>món</small></b></div><div class="surface mini-stat"><span>Danh mục</span><b>04 <small>nhóm</small></b></div></div>
<section class="surface management-panel"><div class="management-toolbar"><div class="search-box compact-search"><span>⌕</span><input placeholder="Tìm tên món..." @bind="_search" @bind:event="oninput" /></div><select class="select-control"><option>Tất cả danh mục</option><option>Cà phê</option><option>Trà</option><option>Đá xay</option><option>Bánh</option></select><select class="select-control"><option>Tất cả trạng thái</option><option>Đang bán</option><option>Hết hàng</option></select><button class="button button-outline filter-button">☷ Bộ lọc</button></div><div class="table-scroll"><table class="data-table"><thead><tr><th>TÊN MÓN</th><th>MÃ MÓN</th><th>DANH MỤC</th><th>GIÁ BÁN</th><th>TRẠNG THÁI</th><th>ĐÃ BÁN</th><th></th></tr></thead><tbody>@foreach(var p in Filtered){<tr><td><div class="table-product"><span class="drink-thumb @p.Tone">@p.Icon</span><span><b>@p.Name</b><small>@p.Subtitle</small></span></div></td><td class="muted-cell">@p.Code</td><td><span class="category-tag">@p.Category</span></td><td class="strong-cell">@Money(p.Price)</td><td><span class="status @(p.Active?"status-done":"status-out")">● @(p.Active?"Đang bán":"Hết hàng")</span></td><td class="muted-cell">@p.Sold ly</td><td><button class="row-action" title="Sửa món" @onclick="()=>EditProduct(p)">···</button></td></tr>}</tbody></table></div><div class="table-footer"><span>Hiển thị <b>@Filtered.Count()</b> trên <b>@_products.Count</b> món</span><div class="pagination"><button>←</button><button class="page-current">1</button><button>2</button><button>→</button></div></div></section>
@if(_editing){<div class="modal-backdrop" @onclick="CloseEditor"><section class="checkout-modal form-modal" @onclick:stopPropagation="true"><button class="modal-close" @onclick="CloseEditor">×</button><div class="eyebrow">THỰC ĐƠN MỘC.</div><h2>@(_selected is null?"Thêm món mới":"Cập nhật món")</h2><p>Điền thông tin sản phẩm để cập nhật thực đơn.</p><label class="form-label">TÊN MÓN</label><input class="form-input" @bind="_formName" placeholder="Ví dụ: Bạc xỉu"/><label class="form-label">DANH MỤC</label><select class="form-input" @bind="_formCategory"><option>Cà phê</option><option>Trà</option><option>Đá xay</option><option>Bánh</option></select><label class="form-label">GIÁ BÁN (₫)</label><input class="form-input" type="number" @bind="_formPrice"/><div class="modal-actions"><button class="button button-outline" @onclick="CloseEditor">Hủy</button><button class="button button-primary" @onclick="SaveProduct">Lưu món</button></div></section></div>}
@code{
private string _search="",_formName="",_formCategory="Cà phê";private int _formPrice=49000;private bool _editing;private MenuProduct? _selected;private IEnumerable<MenuProduct> Filtered=>_products.Where(p=>p.Name.Contains(_search,StringComparison.CurrentCultureIgnoreCase));private static string Money(int v)=>v.ToString("N0",CultureInfo.GetCultureInfo("vi-VN"))+" ₫";
private readonly List<MenuProduct> _products=[new("Bạc xỉu","Cà phê sữa đá truyền thống","CF001","Cà phê",49000,true,42,"drink-coffee","☕"),new("Latte kem muối","Cà phê espresso, kem mặn","CF002","Cà phê",70000,true,36,"drink-latte","☁"),new("Cold brew cam","Cà phê ủ lạnh vị cam","CF003","Cà phê",70000,true,28,"drink-cold","◉"),new("Trà đào cam sả","Trà đào tươi, sả, cam","TE001","Trà",55000,true,24,"drink-tea","♨"),new("Matcha latte","Matcha Nhật, sữa tươi","TE002","Trà",65000,true,18,"drink-matcha","🍵"),new("Croissant bơ","Bánh sừng bò bơ Pháp","BK001","Bánh",38000,false,0,"drink-croissant","🥐")];
private sealed class MenuProduct(string name,string subtitle,string code,string category,int price,bool active,int sold,string tone,string icon){public string Name{get;set;}=name;public string Subtitle{get;}=subtitle;public string Code{get;}=code;public string Category{get;set;}=category;public int Price{get;set;}=price;public bool Active{get;set;}=active;public int Sold{get;}=sold;public string Tone{get;}=tone;public string Icon{get;}=icon;}
private void AddProduct(){_selected=null;_formName="";_formPrice=49000;_formCategory="Cà phê";_editing=true;}private void EditProduct(MenuProduct p){_selected=p;_formName=p.Name;_formCategory=p.Category;_formPrice=p.Price;_editing=true;}private void CloseEditor()=>_editing=false;private void SaveProduct(){if(string.IsNullOrWhiteSpace(_formName))return;if(_selected is null)_products.Add(new(_formName,"Món mới của cửa hàng","NEW00",_formCategory,_formPrice,true,0,"drink-tea","☕"));else{_selected.Name=_formName;_selected.Category=_formCategory;_selected.Price=_formPrice;}_editing=false;}
}
