@page "/inventory"
@rendermode InteractiveServer
@using System.Globalization
<PageTitle>Kho nguyên liệu · mộc. Coffee</PageTitle>
<div class="page-heading"><div><div class="eyebrow">QUẢN LÝ <span class="eyebrow-dot"></span> KHO NGUYÊN LIỆU</div><h1>Mọi thứ đều đủ đầy?</h1><p>Kiểm soát lượng nguyên liệu để mỗi ly cà phê luôn đúng vị.</p></div><button class="button button-primary" @onclick="OpenImport">＋ Nhập nguyên liệu</button></div>
<div class="menu-stats"><div class="surface mini-stat"><span>Tổng nguyên liệu</span><b>24 <small>mặt hàng</small></b></div><div class="surface mini-stat"><span>Số lượng ổn định</span><b>19 <small>mặt hàng</small></b></div><div class="surface mini-stat"><span>Sắp hết hàng</span><b class="low-stock-stat">03 <small>mặt hàng</small></b></div><div class="surface mini-stat"><span>Đã hết hàng</span><b>02 <small>mặt hàng</small></b></div></div>
<section class="surface alert-banner"><div class="alert-symbol">!</div><div><b>Có 3 nguyên liệu cần được chú ý</b><p>Sữa tươi, hạt cà phê Arabica và syrup caramel sắp chạm mức tối thiểu.</p></div><button @onclick="()=>_showAlerts=!_showAlerts">@(_showAlerts?"Thu gọn ↑":"Xem nguyên liệu ↓")</button></section>
<section class="surface management-panel"><div class="management-toolbar"><div class="search-box compact-search"><span>⌕</span><input placeholder="Tìm nguyên liệu..." @bind="_search" @bind:event="oninput"/></div><select class="select-control"><option>Tất cả danh mục</option><option>Cà phê</option><option>Sữa và kem</option><option>Syrup</option><option>Trà và topping</option></select><select class="select-control"><option>Tất cả trạng thái</option><option>Sắp hết</option><option>Hết hàng</option><option>Còn hàng</option></select><button class="button button-outline filter-button">◷ Lịch sử nhập</button></div><div class="table-scroll"><table class="data-table inventory-table"><thead><tr><th>TÊN NGUYÊN LIỆU</th><th>NHÓM</th><th>ĐANG CÓ</th><th>TỒN TỐI THIỂU</th><th>TIẾN ĐỘ TỒN KHO</th><th>TRẠNG THÁI</th><th></th></tr></thead><tbody>@foreach(var item in Filtered){<tr><td><div class="table-product"><span class="inventory-icon @item.IconTone">@item.Icon</span><span><b>@item.Name</b><small>@item.Supplier</small></span></div></td><td><span class="category-tag">@item.Category</span></td><td class="strong-cell">@item.Quantity <small>@item.Unit</small></td><td class="muted-cell">@item.Minimum @item.Unit</td><td><div class="stock-progress"><div class="progress-track"><div class="progress-fill @(item.State=="Hết hàng"?"fill-red":item.State=="Sắp hết"?"fill-warn":"")" style="width:@Math.Min(100,item.Progress)%"></div></div><small>@Math.Min(100,item.Progress)%</small></div></td><td><span class="status @(item.State=="Còn hàng"?"status-done":item.State=="Hết hàng"?"status-out":"status-warning")">● @item.State</span></td><td><button class="row-action" title="Nhập thêm nguyên liệu" @onclick="()=>StartImport(item)">＋</button></td></tr>}</tbody></table></div><div class="table-footer"><span>Hiển thị <b>@Filtered.Count()</b> trên <b>@Items.Count</b> nguyên liệu</span><div class="pagination"><button>←</button><button class="page-current">1</button><button>2</button><button>→</button></div></div></section>
@if(_importing){<div class="modal-backdrop" @onclick="()=>_importing=false"><section class="checkout-modal form-modal" @onclick:stopPropagation="true"><button class="modal-close" @onclick="()=>_importing=false">×</button><div class="eyebrow">KHO MỘC.</div><h2>Nhập nguyên liệu</h2><p>Cập nhật lượng hàng mới nhập vào kho.</p><label class="form-label">NGUYÊN LIỆU</label><select class="form-input" @bind="_selectedName">@foreach(var i in Items){<option>@i.Name</option>}</select><label class="form-label">SỐ LƯỢNG NHẬP</label><input class="form-input" type="number" min="1" @bind="_importQuantity"/><div class="modal-actions"><button class="button button-outline" @onclick="()=>_importing=false">Hủy</button><button class="button button-primary" @onclick="SaveImport">Xác nhận nhập</button></div></section></div>}
@if(_toast is not null){<div class="toast-message">✓ @_toast</div>}
@code{private string _search="",_selectedName="Sữa tươi thanh trùng";private int _importQuantity=10;private bool _importing,_showAlerts;private string? _toast;private IEnumerable<InventoryItem> Filtered=>Items.Where(i=>i.Name.Contains(_search,StringComparison.CurrentCultureIgnoreCase)&&(!_showAlerts||i.State!="Còn hàng"));private sealed class InventoryItem(string name,string supplier,string category,int quantity,string unit,int minimum,int progress,string state,string icon,string iconTone){public string Name{get;}=name;public string Supplier{get;}=supplier;public string Category{get;}=category;public int Quantity{get;set;}=quantity;public string Unit{get;}=unit;public int Minimum{get;}=minimum;public int Progress{get;set;}=progress;public string State{get;set;}=state;public string Icon{get;}=icon;public string IconTone{get;}=iconTone;}private readonly List<InventoryItem> Items=[new("Sữa tươi thanh trùng","Vinamilk · cập nhật 09:15","Sữa và kem",2,"L",5,35,"Sắp hết","🥛","icon-white"),new("Hạt cà phê Arabica","Cầu Đất · rang ngày 21/09","Cà phê",1,"kg",3,24,"Sắp hết","☕","icon-coffee"),new("Syrup caramel Monin","Monin · cập nhật 20/09","Syrup",0,"chai",2,0,"Hết hàng","🍯","icon-honey"),new("Trà ô long đặc biệt","Bảo Lộc · lá trà nguyên chất","Trà và topping",4,"kg",2,76,"Còn hàng","🍃","icon-tea"),new("Kem béo thực vật","Rich's · cập nhật 22/09","Sữa và kem",12,"hộp",4,87,"Còn hàng","🥛","icon-white"),new("Đường cát trắng","Biên Hòa · túi 1kg","Khác",8,"kg",3,89,"Còn hàng","◉","icon-sugar"),new("Trân châu đen","Đài Loan · cập nhật 23/09","Trà và topping",3,"kg",2,60,"Còn hàng","⚫","icon-boba"),new("Syrup vani Monin","Monin · chai 700ml","Syrup",2,"chai",2,50,"Sắp hết","🍯","icon-honey")];private void OpenImport(){_selectedName=Items[0].Name;_importing=true;}private void StartImport(InventoryItem item){_selectedName=item.Name;_importing=true;}private void SaveImport(){var item=Items.FirstOrDefault(i=>i.Name==_selectedName);if(item is not null){item.Quantity+=_importQuantity;item.Progress=Math.Min(100,item.Progress+_importQuantity*8);item.State=item.Quantity<=item.Minimum?"Sắp hết":"Còn hàng";_toast=$"Đã nhập {_importQuantity} {item.Unit} {item.Name.ToLowerInvariant()} vào kho.";}_importing=false;}}
