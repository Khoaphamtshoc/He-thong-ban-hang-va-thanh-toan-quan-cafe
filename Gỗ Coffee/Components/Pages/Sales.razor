@page "/sales"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components
@using System.Globalization
@inject NavigationManager Navigation
@inject StoreDb Db
@inject StoreSession Session
@implements IDisposable
<PageTitle>Bán hàng · mộc. Coffee</PageTitle>
<div class="page-heading sale-heading"><div><div class="eyebrow">BÁN HÀNG <span class="eyebrow-dot"></span> QUẦY THU NGÂN</div><h1>Đơn hàng mới <span class="order-live-pill">Bàn 04 <i></i></span></h1><p>Chọn món từ thực đơn PostgreSQL và tạo đơn hàng cho khách.</p></div><button class="button button-outline" @onclick="ResetCart">↻ <span>Làm mới đơn</span></button></div>
@if (_error is not null) { <div class="toast-message">⚠ @_error</div> }
<div class="sales-layout"><div class="catalogue"><div class="search-box"><span>⌕</span><input placeholder="Tìm món theo tên..." @bind="_query" @bind:event="oninput" /><kbd>⌘ K</kbd></div><div class="category-tabs"><button class="@(_category=="Tất cả"?"category-active":"")" @onclick='()=>ChooseCategory("Tất cả")'>Tất cả <small>@_products.Count</small></button>@foreach(var category in _products.Select(p=>p.Category).Distinct()){<button class="@(_category==category?"category-active":"")" @onclick="()=>ChooseCategory(category)">@category</button>}</div>
<div class="product-grid">@foreach(var product in VisibleProducts){<button class="product-card" @onclick="()=>AddItem(product)"><span class="product-art art-coffee"><span class="product-emoji">@IconFor(product.Category)</span><span class="add-product">＋</span></span><span class="product-details"><b>@product.Name</b><small>@product.Category</small><strong>@Money(product.Price)</strong></span></button>}</div>@if(_products.Count==0&&!_loading){<div class="empty-cart"><b>Chưa có món đang bán</b><p>Kiểm tra bảng products và categories trong cafe_pos.</p></div>}</div>
<aside class="cart-panel"><div class="cart-heading"><div><h2>Đơn hàng</h2><p>Bàn 04 <span>·</span> Khách tại quán</p></div><button class="cart-clear" title="Xóa toàn bộ đơn" @onclick="ResetCart">⌫</button></div><div class="customer-select"><div class="customer-icon">♙</div><div><small>KHÁCH HÀNG</small><b>Khách lẻ</b></div><span style="margin-left:auto">⌄</span></div><div class="cart-items">@if(_cart.Count==0){<div class="empty-cart"><span>☕</span><b>Chưa có món nào</b><p>Chọn món từ thực đơn để bắt đầu.</p></div>} else { @foreach(var entry in _cart){<div class="cart-item"><div class="cart-item-art art-coffee">@IconFor(entry.Product.Category)</div><div class="cart-item-main"><b>@entry.Product.Name</b><small>@Money(entry.Product.Price)</small><div class="quantity-control"><button @onclick="()=>ChangeQty(entry.Product,-1)">−</button><span>@entry.Quantity</span><button @onclick="()=>ChangeQty(entry.Product,1)">＋</button></div></div><b class="cart-line-total">@Money(entry.Product.Price*entry.Quantity)</b></div>}}</div><button class="add-note" @onclick="ToggleNote">＋ Thêm ghi chú đơn hàng</button>@if(_showNote){<textarea class="note-input" placeholder="Ví dụ: ít đá, không đường..." @bind="_note"></textarea>}<div class="cart-totals"><div><span>Tạm tính</span><b>@Money(Subtotal)</b></div><div><span>Thuế VAT <small>(8%)</small></span><b>@Money(Vat)</b></div><div><span>Giảm giá <button class="discount-link" @onclick="()=>_discount=_discount==0?10000:0">@(_discount==0?"+ Thêm":"↻ Bỏ")</button></span><b class="discount-value">−@Money(_discount)</b></div><hr /><div class="cart-grand"><span>Tổng cộng</span><b>@Money(Total)</b></div></div><button class="button button-primary pay-button" disabled="@(_cart.Count==0||_saving)" @onclick="ShowCheckout">@(_saving?"Đang lưu...":"Tiến hành thanh toán →")</button><div class="cart-shortcut">Nhấn <kbd>F4</kbd> để thanh toán nhanh</div></aside></div>
@if (_checkout)
{
    <div class="modal-backdrop" @onclick="CloseCheckout">
        <section class="checkout-modal" @onclick:stopPropagation="true">
            <button class="modal-close" @onclick="CloseCheckout">×</button>
            @if (!_completed)
            {
                <div class="checkout-symbol">₫</div><div class="eyebrow">XÁC NHẬN THANH TOÁN</div><h2>Hoàn tất đơn hàng</h2>
                <p>Đơn bàn 04 · @_cart.Sum(x => x.Quantity) món</p>
                <div class="checkout-total"><span>Khách cần thanh toán</span><b>@Money(Total)</b></div>
                <label class="payment-label">PHƯƠNG THỨC THANH TOÁN</label>
                <div class="payment-options">
                    <button class='payment-option @PaymentClass("Tiền mặt")' @onclick='() => SetPayment("Tiền mặt")'>💵 <span>Tiền mặt</span>@if (_payment == "Tiền mặt") { <i>✓</i> }</button>
                    <button class='payment-option @PaymentClass("Chuyển khoản")' @onclick='() => SetPayment("Chuyển khoản")'>▦ <span>Chuyển khoản</span>@if (_payment == "Chuyển khoản") { <i>✓</i> }</button>
                    <button class='payment-option @PaymentClass("Thẻ")' @onclick='() => SetPayment("Thẻ")'>▤ <span>Thẻ ngân hàng</span>@if (_payment == "Thẻ") { <i>✓</i> }</button>
                </div>
                <button class="button button-primary confirm-button" disabled="@_saving" @onclick="CompleteOrder">@(_saving ? "Đang ghi nhận..." : $"Xác nhận thanh toán · {Money(Total)}")</button>
                <small class="secure-note">Giao dịch và đơn hàng được lưu cùng lúc trong PostgreSQL</small>
            }
            else
            {
                <div class="success-check">✓</div><div class="eyebrow">THANH TOÁN THÀNH CÔNG</div><h2>Cảm ơn bạn!</h2>
                <p>Đơn <b>#@_completedCode</b> đã được ghi nhận.</p>
                <div class="checkout-total"><span>Đã thanh toán qua @_payment</span><b>@Money(_completedTotal)</b></div>
                <button class="button button-primary confirm-button" @onclick="FinishOrder">Tạo đơn hàng mới →</button>
                <a class="success-orders-link" href="/orders">Xem danh sách đơn hàng</a>
            }
        </section>
    </div>
}
@code {
    private string _query="",_category="Tất cả",_payment="Tiền mặt",_note=""; private bool _checkout,_completed,_showNote,_loading=true,_saving; private decimal _discount,_completedTotal; private string? _completedCode,_error;
    private readonly List<CartItem> _cart=[]; private List<MenuProduct> _products=[];
    private static string Money(decimal value)=>value.ToString("N0",CultureInfo.GetCultureInfo("vi-VN"))+" ₫";
    private decimal Subtotal=>_cart.Sum(x=>x.Product.Price*x.Quantity); private decimal Vat=>decimal.Round(Subtotal*.08m,0,MidpointRounding.AwayFromZero); private decimal Total=>Math.Max(0,Subtotal+Vat-_discount);
    private IEnumerable<MenuProduct> VisibleProducts=>_products.Where(p=>(_category=="Tất cả"||p.Category==_category)&&p.Name.Contains(_query,StringComparison.CurrentCultureIgnoreCase));
    private sealed class CartItem(MenuProduct product,decimal quantity){public MenuProduct Product{get;}=product;public decimal Quantity{get;set;}=quantity;}
    private static string IconFor(string category)=>category switch{"Trà"=>"🍵","Đá xay"=>"🧋","Bánh"=>"🥐",_=>"☕"};
    protected override async Task OnInitializedAsync(){try{_products=await Db.GetProductsAsync();}catch(Exception ex){_error=$"Không đọc được thực đơn PostgreSQL: {ex.Message}";}finally{_loading=false;}}
    private void ChooseCategory(string value)=>_category=value;
    private void AddItem(MenuProduct product){var item=_cart.FirstOrDefault(x=>x.Product.Id==product.Id);if(item is null)_cart.Add(new(product,1));else item.Quantity++;}
    private void ChangeQty(MenuProduct product,int amount){var item=_cart.FirstOrDefault(x=>x.Product.Id==product.Id);if(item is null)return;item.Quantity+=amount;if(item.Quantity<=0)_cart.Remove(item);}
    private void ToggleNote()=>_showNote=!_showNote; private void ResetCart(){_cart.Clear();_discount=0;_note="";_showNote=false;_error=null;}
    private void ShowCheckout(){if(_cart.Count>0)_checkout=true;} private void CloseCheckout()=>_checkout=false;
    private string PaymentClass(string method)=>_payment==method?"payment-selected":""; private void SetPayment(string method)=>_payment=method;
    private async Task CompleteOrder(){if(_saving||_cart.Count==0)return;_saving=true;_error=null;try{_completedTotal=Total;_completedCode=await Db.CreateOrderAsync(_cart.Select(x=>new CheckoutLine(x.Product.Id,x.Quantity,null)).ToList(),_payment,8,_discount,_note,"04");_completed=true;}catch(Exception ex){_error=$"Chưa thanh toán được: {ex.Message}";}finally{_saving=false;}}
    private void FinishOrder(){_checkout=false;_completed=false;_payment="Tiền mặt";_completedCode=null;ResetCart();}
    protected override void OnInitialized()=>Navigation.LocationChanged+=OnLocationChanged;
    private void OnLocationChanged(object? sender,Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e){if(new Uri(e.Location).AbsolutePath.EndsWith("/sales",StringComparison.OrdinalIgnoreCase))InvokeAsync(StateHasChanged);}
    public void Dispose()=>Navigation.LocationChanged-=OnLocationChanged;
}
