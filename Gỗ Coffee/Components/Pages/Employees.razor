@page "/employees"
@rendermode InteractiveServer
<PageTitle>Nhân viên · Gỗ Coffee</PageTitle>

<div class="page-heading"><div><div class="eyebrow">QUẢN LÝ <span class="eyebrow-dot"></span> NHÂN SỰ</div><h1>Đội ngũ Gỗ Coffee</h1><p>Quản lý nhân viên, ca làm và quyền truy cập hệ thống.</p></div><button class="button button-primary" @onclick="AddEmployee">＋ Thêm nhân viên</button></div>
<div class="menu-stats"><div class="surface mini-stat"><span>Tổng nhân viên</span><b>@_employees.Count <small>người</small></b></div><div class="surface mini-stat"><span>Đang làm việc</span><b>@_employees.Count(x => x.Active) <small>người</small></b></div><div class="surface mini-stat"><span>Nghỉ hôm nay</span><b>@_employees.Count(x => !x.Active) <small>người</small></b></div><div class="surface mini-stat"><span>Ca hiện tại</span><b>Ca sáng <small>07:00 – 15:00</small></b></div></div>
<div class="employee-tabs"><button class="employee-tab-active">Tất cả nhân viên <b>@_employees.Count</b></button><button>Đang hoạt động <b>@_employees.Count(x => x.Active)</b></button><button>Đã nghỉ <b>@_employees.Count(x => !x.Active)</b></button><span></span><select class="select-control"><option>Tất cả vai trò</option><option>Admin</option><option>Quản lý</option><option>Nhân viên</option></select></div>
<section class="surface management-panel"><div class="management-toolbar"><div class="search-box compact-search"><span>⌕</span><input placeholder="Tìm theo tên, email..." @bind="_search" @bind:event="oninput" /></div><button class="button button-outline filter-button">☷ Bộ lọc</button><button class="button button-primary employee-add-toolbar" @onclick="AddEmployee">＋ Thêm nhân viên</button></div><div class="table-scroll"><table class="data-table"><thead><tr><th>NHÂN VIÊN</th><th>VAI TRÒ</th><th>CA LÀM</th><th>NGÀY VÀO LÀM</th><th>TRẠNG THÁI</th><th></th></tr></thead><tbody>@foreach(var e in Filtered){<tr><td><div class="table-product"><span class="employee-avatar @e.Tone">@e.Initials</span><span><b>@e.Name</b><small>@e.Email</small></span></div></td><td><span class="role-tag @e.RoleClass">@e.Role</span></td><td>@e.Shift</td><td class="muted-cell">@e.Joined</td><td><span class="status @(e.Active?"status-done":"status-off")">● @(e.Active?"Đang làm":"Nghỉ phép")</span></td><td><div class="employee-actions"><button class="row-action" title="Thao tác nhân viên" aria-expanded="@(_menuFor==e.Id)" @onclick="()=>ToggleMenu(e)">···</button>@if(_menuFor==e.Id){<div class="employee-action-menu"><button @onclick="()=>EditEmployee(e)">✎ <span>Sửa thông tin</span></button><button class="delete-action" @onclick="()=>ConfirmDelete(e)">⌫ <span>Xóa nhân viên</span></button></div>}</div></td></tr>}</tbody></table></div><div class="table-footer"><span>Hiển thị <b>@Filtered.Count()</b> trên <b>@_employees.Count</b> nhân viên</span><div class="pagination"><button>←</button><button class="page-current">1</button><button>2</button><button>→</button></div></div></section>
<section class="surface roles-panel"><div class="surface-heading"><div><h2>Phân quyền hệ thống</h2><p>Mỗi vai trò có quyền truy cập phù hợp với nhiệm vụ.</p></div></div><div class="role-cards"><article><span class="role-symbol admin-symbol">♙</span><div><b>Admin</b><p>Toàn quyền cấu hình hệ thống, xem báo cáo, quản lý nhân viên và dữ liệu.</p></div><span class="role-members">1 người</span></article><article><span class="role-symbol manager-symbol">⌂</span><div><b>Quản lý</b><p>Quản lý thực đơn, kho, đơn hàng, doanh thu và phân ca cho nhân viên.</p></div><span class="role-members">2 người</span></article><article><span class="role-symbol staff-symbol">♧</span><div><b>Nhân viên</b><p>Tạo đơn hàng, thanh toán và theo dõi các đơn đang thực hiện.</p></div><span class="role-members">4 người</span></article></div></section>

@if(_modal){<div class="modal-backdrop" @onclick="CloseModal"><section class="checkout-modal form-modal" @onclick:stopPropagation="true"><button class="modal-close" @onclick="CloseModal">×</button><div class="eyebrow">ĐỘI NGŨ GỖ COFFEE</div><h2>@(_selected is null?"Thêm nhân viên":"Sửa thông tin nhân viên")</h2><p>Cập nhật thông tin và quyền truy cập hệ thống.</p><label class="form-label">HỌ VÀ TÊN</label><input class="form-input" @bind="_formName" placeholder="Nguyễn Văn A"/><label class="form-label">EMAIL</label><input class="form-input" type="email" @bind="_formEmail" placeholder="ten@gocoffee.vn"/><label class="form-label">VAI TRÒ HỆ THỐNG</label><select class="form-input" @bind="_formRole"><option>Admin</option><option>Quản lý</option><option>Nhân viên</option></select><label class="form-label">CA LÀM</label><select class="form-input" @bind="_formShift"><option>Ca sáng · 07:00 – 15:00</option><option>Ca chiều · 15:00 – 23:00</option><option>Ca linh hoạt</option></select><div class="modal-actions"><button class="button button-outline" @onclick="CloseModal">Hủy</button><button class="button button-primary" @onclick="SaveEmployee">@(_selected is null?"Thêm nhân viên":"Lưu thay đổi")</button></div></section></div>}
@if(_deleteTarget is not null){<div class="modal-backdrop" @onclick="CancelDelete"><section class="checkout-modal delete-modal" @onclick:stopPropagation="true"><button class="modal-close" @onclick="CancelDelete">×</button><div class="delete-confirm-icon">⌫</div><h2>Xóa nhân viên?</h2><p>Bạn có chắc muốn xóa <b>@_deleteTarget.Name</b> khỏi danh sách nhân viên? Thao tác này không thể hoàn tác.</p><div class="modal-actions"><button class="button button-outline" @onclick="CancelDelete">Giữ lại</button><button class="button delete-confirm-button" @onclick="DeleteEmployee">Xóa nhân viên</button></div></section></div>}
@if(_toast is not null){<div class="toast-message">✓ @_toast</div>}

@code {
    private string _search="",_formName="",_formEmail="",_formRole="Nhân viên",_formShift="Ca sáng · 07:00 – 15:00";
    private bool _modal; private Staff? _selected; private Staff? _deleteTarget; private int? _menuFor; private string? _toast;
    private IEnumerable<Staff> Filtered => _employees.Where(x=>x.Name.Contains(_search,StringComparison.CurrentCultureIgnoreCase)||x.Email.Contains(_search,StringComparison.CurrentCultureIgnoreCase));
    private readonly List<Staff> _employees=[new(1,"Anh Duy","anhduy@moc.coffee","AD","Admin","role-admin","Ca sáng · 07:00 – 15:00","12/03/2024",true,"tone-sage"),new(2,"Hoàng Nam","hoangnam@moc.coffee","HN","Quản lý","role-manager","Ca sáng · 07:00 – 15:00","08/06/2024",true,"tone-peach"),new(3,"Thảo Vy","thaovy@moc.coffee","TV","Quản lý","role-manager","Ca chiều · 15:00 – 23:00","22/07/2024",true,"tone-lavender"),new(4,"Quốc Bảo","quocbao@moc.coffee","QB","Nhân viên","role-staff","Ca sáng · 07:00 – 15:00","14/01/2025",true,"tone-yellow"),new(5,"Hà Linh","halinh@moc.coffee","HL","Nhân viên","role-staff","Ca chiều · 15:00 – 23:00","02/04/2025",true,"tone-peach"),new(6,"Khánh An","khanhan@moc.coffee","KA","Nhân viên","role-staff","Ca linh hoạt","17/11/2025",false,"tone-lavender")];
    private sealed class Staff(int id,string name,string email,string initials,string role,string roleClass,string shift,string joined,bool active,string tone){public int Id{get;}=id;public string Name{get;set;}=name;public string Email{get;set;}=email;public string Initials{get;set;}=initials;public string Role{get;set;}=role;public string RoleClass{get;set;}=roleClass;public string Shift{get;set;}=shift;public string Joined{get;}=joined;public bool Active{get;}=active;public string Tone{get;}=tone;}
    private void ToggleMenu(Staff employee)=>_menuFor=_menuFor==employee.Id?null:employee.Id;
    private void AddEmployee(){_selected=null;_formName="";_formEmail="";_formRole="Nhân viên";_formShift="Ca sáng · 07:00 – 15:00";_menuFor=null;_modal=true;}
    private void EditEmployee(Staff employee){_selected=employee;_formName=employee.Name;_formEmail=employee.Email;_formRole=employee.Role;_formShift=employee.Shift;_menuFor=null;_modal=true;}
    private void CloseModal()=>_modal=false;
    private void SaveEmployee(){var name=_formName.Trim();var email=_formEmail.Trim();if(name.Length==0||email.Length==0)return;var roleClass=_formRole=="Admin"?"role-admin":_formRole=="Quản lý"?"role-manager":"role-staff";if(_selected is null){var initials=string.Concat(name.Split(' ',StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(x=>x[0])).ToUpperInvariant();var id=_employees.Count==0?1:_employees.Max(x=>x.Id)+1;_employees.Add(new(id,name,email,initials,_formRole,roleClass,_formShift,DateTime.Now.ToString("dd/MM/yyyy"),true,"tone-sage"));_toast=$"Đã thêm nhân viên {name}.";}else{_selected.Name=name;_selected.Email=email;_selected.Initials=string.Concat(name.Split(' ',StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(x=>x[0])).ToUpperInvariant();_selected.Role=_formRole;_selected.RoleClass=roleClass;_selected.Shift=_formShift;_toast=$"Đã cập nhật thông tin {name}.";}_modal=false;}
    private void ConfirmDelete(Staff employee){_deleteTarget=employee;_menuFor=null;}
    private void CancelDelete()=>_deleteTarget=null;
    private void DeleteEmployee(){if(_deleteTarget is null)return;var name=_deleteTarget.Name;_employees.Remove(_deleteTarget);_toast=$"Đã xóa nhân viên {name}.";_deleteTarget=null;}
}
