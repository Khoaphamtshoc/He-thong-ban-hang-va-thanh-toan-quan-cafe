@page "/orders"
@rendermode InteractiveServer
@using System.Globalization
<PageTitle>Đơn hàng · mộc. Coffee</PageTitle>
<div class="page-heading"><div><div class="eyebrow">BÁN HÀNG <span class="eyebrow-dot"></span> ĐƠN HÀNG</div><h1>Quản lý đơn hàng</h1><p>Theo dõi và cập nhật trạng thái các đơn hàng trong ngày.</p></div><a class="button button-primary" href="/sales">＋ Tạo đơn mới</a></div>
<div class="order-filter-cards"><button class="order-filter-card @(_filter=="Tất cả"?"order-filter-active":"")" @onclick='()=>_filter="Tất cả"'><small>TẤT CẢ ĐƠN</small><b>148</b><span>Hôm nay <i>↗ 8,2%</i></span></button><button class="order-filter-card @(_filter=="Đang pha chế"?"order-filter-active":"")" @onclick='()=>_filter="Đang pha chế"'><small>ĐANG PHA CHẾ</small><b>08</b><span>Đang chờ hoàn tất</span></button><button class="order-filter-card @(_filter=="Hoàn tất"?"order-filter-active":"")" @onclick='()=>_filter="Hoàn tất"'><small>ĐÃ HOÀN TẤT</small><b>132</b><span>Đã phục vụ thành công</span></button><button class="order-filter-card @(_filter=="Đã hủy"?"order-filter-active":"")" @onclick='()=>_filter="Đã hủy"'><small>ĐÃ HỦY</small><b>08</b><span>Đơn hàng bị hủy</span></button></div>
<section class="surface management-panel"><div class="management-toolbar"><div class="search-box compact-search"><span>⌕</span><input placeholder="Tìm mã đơn, tên khách..." @bind="_search" @bind:event="oninput"/></div><select class="select-control"><option>Hôm nay, 24/09/2026</option><option>Hôm qua</option><option>Tuần này</option></select><select class="select-control"><option>Tất cả phương thức</option><option>Tiền mặt</option><option>Chuyển khoản</option></select></div><div class="table-scroll"><table class="data-table"><thead><tr><th>MÃ ĐƠN</th><th>KHÁCH HÀNG</th><th>CHI TIẾT MÓN</th><th>THỜI GIAN</th><th>TỔNG CỘNG</th><th>THANH TOÁN</th><th>TRẠNG THÁI</th><th></th></tr></thead><tbody>@foreach(var o in Filtered){<tr><td><b class="order-id">@o.Id</b></td><td><div class="customer-cell"><i class="customer-avatar @o.Tone">@o.Initials</i>@o.Name</div></td><td class="muted-cell">@o.Items</td><td class="muted-cell">@o.Time</td><td class="strong-cell">@Money(o.Total)</td><td><span class="pay-method">@o.Payment</span></td><td><select class="status-select @o.StatusClass" value="@o.Status" @onchange="(e)=>UpdateStatus(o,e.Value?.ToString()??o.Status)"><option>Hoàn tất</option><option>Đang pha chế</option><option>Đã hủy</option></select></td><td><button class="row-action" title="Hủy đơn" @onclick="()=>Cancel(o)">···</button></td></tr>}</tbody></table></div><div class="table-footer"><span>Hiển thị <b>@Filtered.Count()</b> trên <b>148</b> đơn hàng</span><div class="pagination"><button>←</button><button class="page-current">1</button><button>2</button><button>3</button><button>…</button><button>15</button><button>→</button></div></div></section>
@if(_toast is not null){<div class="toast-message">✓ @_toast</div>}
@code{private string _filter="Tất cả",_search="";private string? _toast;private IEnumerable<Order> Filtered=>OrderData.Where(o=>(_filter=="Tất cả"||o.Status==_filter)&&(_search.Length==0||o.Id.Contains(_search,StringComparison.OrdinalIgnoreCase)||o.Name.Contains(_search,StringComparison.CurrentCultureIgnoreCase)));private static string Money(int v)=>v.ToString("N0",CultureInfo.GetCultureInfo("vi-VN"))+" ₫";private sealed class Order(string id,string name,string initials,string items,string time,int total,string payment,string status,string tone){public string Id{get;}=id;public string Name{get;}=name;public string Initials{get;}=initials;public string Items{get;}=items;public string Time{get;}=time;public int Total{get;}=total;public string Payment{get;}=payment;public string Status{get;set;}=status;public string StatusClass=>Status=="Hoàn tất"?"status-done":Status=="Đã hủy"?"status-cancel":"status-making";public string Tone{get;}=tone;}private readonly List<Order> OrderData=[new("#DH-0248","Nguyễn Hà Linh","NL","Bạc xỉu, Matcha latte","09:42",96000,"Chuyển khoản","Hoàn tất","tone-sage"),new("#DH-0247","Phạm Quốc Bảo","QB","Latte kem muối, Cold brew","09:36",125000,"Tiền mặt","Hoàn tất","tone-lavender"),new("#DH-0246","Đơn tại quầy","TQ","Trà đào cam sả × 2","09:31",78000,"Tiền mặt","Đang pha chế","tone-peach"),new("#DH-0245","Trần Thu Hà","TH","Bạc xỉu, Croissant bơ","09:24",154000,"Chuyển khoản","Hoàn tất","tone-yellow"),new("#DH-0244","Lê Minh Đức","MĐ","Cold brew cam","09:18",70000,"Tiền mặt","Đang pha chế","tone-sage"),new("#DH-0243","Đơn tại quầy","TQ","Matcha latte × 2","09:11",130000,"Tiền mặt","Đã hủy","tone-peach")];private void UpdateStatus(Order o,string value){o.Status=value;_toast=$"Đã cập nhật đơn {o.Id} thành {value.ToLowerInvariant()}.";}private void Cancel(Order o){o.Status="Đã hủy";_toast=$"Đã hủy đơn {o.Id}.";}}
