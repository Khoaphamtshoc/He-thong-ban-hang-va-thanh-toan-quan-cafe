@page "/orders"
@rendermode InteractiveServer
@using System.Globalization
@inject StoreDb Db
<PageTitle>Đơn hàng · mộc. Coffee</PageTitle>
<div class="page-heading"><div><div class="eyebrow">BÁN HÀNG <span class="eyebrow-dot"></span> ĐƠN HÀNG</div><h1>Quản lý đơn hàng</h1><p>Theo dõi đơn hàng và khoản thanh toán đã lưu trong PostgreSQL.</p></div><a class="button button-primary" href="/sales">＋ Tạo đơn mới</a></div>
<div class="order-filter-cards"><button class="order-filter-card @(_filter=="Tất cả"?"order-filter-active":"")" @onclick='()=>_filter="Tất cả"'><small>TẤT CẢ ĐƠN</small><b>@_orders.Count</b><span>Đã ghi nhận</span></button><button class="order-filter-card @(_filter=="Đang pha chế"?"order-filter-active":"")" @onclick='()=>_filter="Đang pha chế"'><small>ĐANG PHA CHẾ</small><b>@_orders.Count(o=>o.Status=="Đang pha chế")</b><span>Đang chờ hoàn tất</span></button><button class="order-filter-card @(_filter=="Hoàn tất"?"order-filter-active":"")" @onclick='()=>_filter="Hoàn tất"'><small>ĐÃ HOÀN TẤT</small><b>@_orders.Count(o=>o.Status=="Hoàn tất")</b><span>Đã phục vụ thành công</span></button><button class="order-filter-card @(_filter=="Đã hủy"?"order-filter-active":"")" @onclick='()=>_filter="Đã hủy"'><small>ĐÃ HỦY</small><b>@_orders.Count(o=>o.Status=="Đã hủy")</b><span>Đơn bị hủy</span></button></div>
@if(_error is not null){<div class="toast-message">⚠ @_error</div>}
<section class="surface management-panel"><div class="management-toolbar"><div class="search-box compact-search"><span>⌕</span><input placeholder="Tìm mã đơn, tên khách..." @bind="_search" @bind:event="oninput"/></div><select class="select-control" @bind="_paymentFilter"><option value="">Tất cả phương thức</option><option value="CASH">Tiền mặt</option><option value="BANK_TRANSFER">Chuyển khoản</option><option value="CARD">Thẻ</option></select><button class="button button-outline" @onclick="LoadOrdersAsync">↻ Tải lại</button></div><div class="table-scroll"><table class="data-table"><thead><tr><th>MÃ ĐƠN</th><th>KHÁCH HÀNG</th><th>CHI TIẾT MÓN</th><th>THỜI GIAN</th><th>TỔNG CỘNG</th><th>THANH TOÁN</th><th>TRẠNG THÁI</th></tr></thead><tbody>@foreach(var o in Filtered){<tr><td><b class="order-id">#@o.Code</b></td><td><div class="customer-cell"><i class="customer-avatar tone-sage">@Initials(o.Customer)</i>@o.Customer</div></td><td class="muted-cell">@o.Items</td><td class="muted-cell">@o.OrderedAt.ToLocalTime().ToString("dd/MM HH:mm")</td><td class="strong-cell">@Money(o.Total)</td><td><span class="pay-method">@PaymentLabel(o.Payment)</span></td><td><select class="status-select @StatusClass(o.Status)" value="@StatusLabel(o.Status)" @onchange="e=>UpdateStatusAsync(o,e.Value?.ToString()??StatusLabel(o.Status))"><option>Hoàn tất</option><option>Đang pha chế</option><option>Đã hủy</option></select></td></tr>}</tbody></table></div><div class="table-footer"><span>@(_loading?"Đang tải...":$"Hiển thị {Filtered.Count()} trên {_orders.Count} đơn hàng")</span></div></section>
@if(_toast is not null){<div class="toast-message">✓ @_toast</div>}
@code{
    private string _filter="Tất cả",_search="",_paymentFilter=""; private string? _toast,_error; private bool _loading; private List<StoreOrder> _orders=[];
    private IEnumerable<StoreOrder> Filtered=>_orders.Where(o=>(_filter=="Tất cả"||StatusLabel(o.Status)==_filter)&&(_search.Length==0||o.Code.Contains(_search,StringComparison.OrdinalIgnoreCase)||o.Customer.Contains(_search,StringComparison.CurrentCultureIgnoreCase))&&(_paymentFilter.Length==0||o.Payment==_paymentFilter));
    protected override Task OnInitializedAsync()=>LoadOrdersAsync();
    private async Task LoadOrdersAsync(){_loading=true;_error=null;try{_orders=await Db.GetOrdersAsync();}catch(Exception ex){_error=$"Không tải được đơn hàng: {ex.Message}";}finally{_loading=false;}}
    private async Task UpdateStatusAsync(StoreOrder order,string value){try{await Db.UpdateOrderStatusAsync(order.Id,value);_toast=$"Đã cập nhật đơn #{order.Code}.";await LoadOrdersAsync();}catch(Exception ex){_error=$"Không cập nhật được trạng thái: {ex.Message}";}}
    private static string StatusLabel(string status)=>status switch{"COMPLETED"=>"Hoàn tất","CANCELLED"=>"Đã hủy",_=>"Đang pha chế"};
    private static string StatusClass(string status)=>status switch{"COMPLETED"=>"status-done","CANCELLED"=>"status-cancel",_=>"status-making"};
    private static string PaymentLabel(string method)=>method switch{"CASH"=>"Tiền mặt","BANK_TRANSFER"=>"Chuyển khoản","CARD"=>"Thẻ",_=>method};
    private static string Initials(string name)=>string.Concat(name.Split(' ',StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(x=>x[0])).ToUpperInvariant();
    private static string Money(decimal value)=>value.ToString("N0",CultureInfo.GetCultureInfo("vi-VN"))+" ₫";
}
