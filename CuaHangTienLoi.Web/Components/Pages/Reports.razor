@page "/reports"
@using Microsoft.AspNetCore.Components
@rendermode InteractiveServer
@using System.Globalization
<PageTitle>Doanh thu · mộc. Coffee</PageTitle>
<div class="page-heading"><div><div class="eyebrow">PHÂN TÍCH <span class="eyebrow-dot"></span> DOANH THU</div><h1>Báo cáo kinh doanh</h1><p>Theo dõi doanh thu và hiệu suất hoạt động cửa hàng.</p></div><button class="button button-outline" @onclick="Export">↧ <span>Xuất báo cáo</span></button></div>
<div class="report-filters"><div class="date-filter">▦ <span>01 Tháng 9 — 24 Tháng 9, 2026</span>⌄</div><select class="select-control"><option>Tất cả chi nhánh</option><option>Cửa hàng trung tâm</option></select><div class="report-filter-pills"><button class="filter-pill">Hôm nay</button><button class="filter-pill">7 ngày</button><button class="filter-pill active-filter">Tháng này</button></div></div>
<div class="report-kpis"><div class="surface report-kpi"><span>DOANH THU THUẦN</span><b>184.650.000 <small>₫</small></b><i>↗ 12,8% <span>so với tháng trước</span></i><div class="kpi-icon">₫</div></div><div class="surface report-kpi"><span>TỔNG SỐ ĐƠN</span><b>3.248 <small>đơn</small></b><i>↗ 8,2% <span>so với tháng trước</span></i><div class="kpi-icon lavender-kpi">▤</div></div><div class="surface report-kpi"><span>GIÁ TRỊ TRUNG BÌNH</span><b>56.848 <small>₫</small></b><i>↗ 4,1% <span>so với tháng trước</span></i><div class="kpi-icon peach-kpi">⌁</div></div><div class="surface report-kpi"><span>TỶ LỆ HOÀN THÀNH</span><b>96,4 <small>%</small></b><i class="positive-neutral">78 đơn <span>đang xử lý</span></i><div class="kpi-icon green-kpi">✓</div></div></div>
<div class="reports-grid"><section class="surface report-chart-panel"><div class="surface-heading"><div><h2>Biến động doanh thu</h2><p>Doanh thu và đơn hàng theo ngày</p></div><select class="select-control"><option>Doanh thu</option><option>Số đơn</option></select></div><div class="report-chart-legend"><span><i></i> Doanh thu tháng này</span><span><i></i> Doanh thu tháng trước</span></div><div class="report-chart"><div class="report-chart-y"><span>12 tr</span><span>9 tr</span><span>6 tr</span><span>3 tr</span><span>0</span></div><svg viewBox="0 0 780 260" preserveAspectRatio="none"><defs><linearGradient id="reportFill" x1="0" x2="0" y1="0" y2="1"><stop offset="0%" stop-color="#326750" stop-opacity=".15"/><stop offset="100%" stop-color="#326750" stop-opacity="0"/></linearGradient></defs><path class="report-grid-lines" d="M0 14H780M0 69H780M0 124H780M0 179H780M0 234H780"/><path class="report-prior" d="M0 193C35 187 40 155 72 168S110 131 144 143S182 155 216 113S256 140 287 123S329 100 361 113S401 87 432 101S474 75 503 89S543 74 576 85S619 47 648 64S688 78 720 48S755 58 780 38"/><path class="report-area" d="M0 173C37 162 43 195 74 155S111 170 145 123S179 151 216 90S251 119 289 105S328 76 361 88S398 103 432 58S469 91 505 65S542 49 577 70S614 33 649 45S685 32 721 18S755 37 780 12L780 234L0 234Z"/><path class="report-line" d="M0 173C37 162 43 195 74 155S111 170 145 123S179 151 216 90S251 119 289 105S328 76 361 88S398 103 432 58S469 91 505 65S542 49 577 70S614 33 649 45S685 32 721 18S755 37 780 12"/></svg></div><div class="report-chart-x"><span>01/09</span><span>04/09</span><span>07/09</span><span>10/09</span><span>13/09</span><span>16/09</span><span>19/09</span><span>22/09</span><span>24/09</span></div></section>
<section class="surface payment-panel"><div class="surface-heading"><div><h2>Phương thức thanh toán</h2><p>Phân bố doanh thu theo phương thức</p></div></div><div class="payment-donut-wrap"><div class="donut-chart"><div><b>184,6</b><small>triệu ₫</small></div></div></div><div class="payment-legend"><div><i class="pay-color cash-color"></i><span>Tiền mặt</span><b>52,4%</b></div><div><i class="pay-color bank-color"></i><span>Chuyển khoản</span><b>38,2%</b></div><div><i class="pay-color card-color"></i><span>Thẻ ngân hàng</span><b>9,4%</b></div></div></section></div>
<section class="surface management-panel report-table-panel"><div class="surface-heading"><div><h2>Doanh thu theo ngày</h2><p>Chi tiết hoạt động trong tháng 9</p></div><a class="text-link" href="/orders">Xem đơn hàng →</a></div><div class="table-scroll"><table class="data-table"><thead><tr><th>NGÀY</th><th>SỐ ĐƠN</th><th>DOANH THU</th><th>GIÁ TRỊ TRUNG BÌNH</th><th>SO VỚI HÔM TRƯỚC</th></tr></thead><tbody>@foreach(var day in Days){<tr><td class="strong-cell">@day.Date</td><td>@day.Orders đơn</td><td class="strong-cell">@day.Revenue.ToString("N0",CultureInfo.GetCultureInfo("vi-VN")) ₫</td><td class="muted-cell">@((day.Revenue/day.Orders).ToString("N0",CultureInfo.GetCultureInfo("vi-VN"))) ₫</td><td><span class="trend-up">↗ @day.Delta%</span></td></tr>}</tbody></table></div></section>
@if(_exported){<div class="toast-message">✓ Báo cáo tháng 9/2026 đã sẵn sàng để lưu.</div>}
@code{private bool _exported;private sealed record DayRow(string Date,int Orders,int Revenue,int Delta);private static readonly DayRow[] Days=[new("24 Tháng 9, 2026",148,8450000,12),new("23 Tháng 9, 2026",139,7490000,6),new("22 Tháng 9, 2026",156,8920000,14),new("21 Tháng 9, 2026",118,6470000,3)];private void Export()=>_exported=true;}
